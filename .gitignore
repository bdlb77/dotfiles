# macOS
.DS_Store
.AppleDouble
.LSOverride

# Local per-machine overrides (sourced/included by main configs)
*.local
.zshrc.local
.gitconfig.local

# Backups created by stow / install
*.backup
*.bak

# Editor scratch
.idea/
*.swp
*.swo

# Tooling caches accidentally created in repo
node_modules/
.venv/
__pycache__/

# tmux plugins (installed by tpm; they should live at ~/.tmux/plugins/)
tmux/.config/tmux/plugins/

# opencode plugins (installed via npm/bun)
opencode/.config/opencode/node_modules/
opencode/.config/opencode/package-lock.json
opencode/.config/opencode/bun.lock
