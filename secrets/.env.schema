# secrets/.env.schema
# Per https://varlock.dev/plugins/1password/#loading-1password-environments
# Uses desktop-app auth + the BETA op CLI (which supports `op environment`).
#
# REQUIRES: beta op CLI (>= 2.33.0). Install steps in Brewfile comment block.
# Verify: `op --version` must show a beta build (e.g. 2.35.0-beta.01).
# If `op env list` errors with "unknown command 'environment'", you're on
# stable op CLI — re-install beta and re-link:
#   ln -sfn /usr/local/bin/op /opt/homebrew/bin/op

# @plugin(@varlock/1password-plugin@1.1.0)
# @initOp(allowAppAuth=true, account=my)
# @setValuesBulk(opLoadEnvironment(n5iop4thh5yt6koffgiu2t3idi))
# ---

# @sensitive @docs(https://github.com/settings/tokens)
GITHUB_TOKEN=

# @sensitive @docs(https://www.figma.com/developers/api#access-tokens)
FIGMA_KEY_OSU=
