# secrets/.env.schema
# Varlock schema for shell environment secrets.
#
# Real values resolve from 1Password via the @varlock/1password-plugin.
# Authentication: Desktop app (Touch ID) on local machines — no service account
# needed. Requires:
#   - 1Password desktop app installed + signed in
#   - "Integrate with 1Password CLI" enabled in 1Password Settings > Developer
#   - 1Password CLI (`op`) installed (transparent dependency)
#
# Usage:
#   varlock run -- some-command          # inject vars into one command
#   eval "$(varlock load --format=shell)" # export into current shell

# @plugin(@varlock/1password-plugin)
# @initOp(allowAppAuth=true)
# ---

# ============================================================================
# Add per-secret entries below. Examples shown commented out — uncomment and
# adjust the secret references for your vault.
# ============================================================================

# # @sensitive @docs(https://github.com/settings/tokens)
# GITHUB_TOKEN=op(op://Personal/GitHub PAT/token)

# # @sensitive
# FIGMA_API_KEY=op(op://Personal/Figma/api_key)

# # @sensitive @type=string(startsWith=sk-ant-api)
# # @docs(https://platform.claude.com/docs/en/api/overview)
# ANTHROPIC_API_KEY=op(op://Personal/Anthropic API/key)

# # @sensitive
# OPENAI_API_KEY=op(op://Personal/OpenAI API/key)
