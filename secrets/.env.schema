# secrets/.env.schema
# Varlock schema for shell environment secrets.
#
# Real values resolve from a 1Password Environment via the
# @varlock/1password-plugin. Authentication uses the desktop app (Touch ID)
# on local machines — no service account needed.
#
# Requires:
#   - 1Password desktop app installed + signed in
#   - "Integrate with 1Password CLI" enabled in 1Password Settings > Developer
#   - 1Password CLI (`op`) installed (transparent dependency)
#   - For 1Password Environments via desktop-app auth, the BETA `op` CLI (>= 2.33.0)
#     is required. Download from: https://app-updates.agilebits.com/product_history/CLI2
#
# Usage:
#   varlock run -- some-command            # inject vars into one command
#   eval "$(varlock load --format=shell)"  # export into current shell

# @plugin(@varlock/1password-plugin)
# @initOp(allowAppAuth=true)
# @setValuesBulk(opLoadEnvironment(n5iop4thh5yt6koffgiu2t3idi))
# ---

# ============================================================================
# Declared secrets (resolved from the 1Password Environment above)
# ============================================================================

# @sensitive @docs(https://github.com/settings/tokens)
GITHUB_TOKEN=

# @sensitive @docs(https://www.figma.com/developers/api#access-tokens)
FIGMA_KEY_OSU=

# Add more below as needed. Names must match variable names in the
# 1Password Environment.
#
# Example:
# # @sensitive @type=string(startsWith=sk-ant-api)
# ANTHROPIC_API_KEY=
